{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/((?:play|t|anime|movies|series|genre|category|list|continue|coming|manga|account)(?:/.*)?)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(js|css)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
